# Bitcoin Knots Native Dashboard - Environment Configuration
# 
# Primary location for user services (recommended):
#   ~/.config/bitcoin-dashboard.env
#
# Alternative:
#   /etc/default/bitcoin-dashboard

# === Bitcoin RPC Configuration (required) ===
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=marian
BITCOIN_RPC_PASSWORD=keli

# === Optional Dashboard Settings ===
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8335
